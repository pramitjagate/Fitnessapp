# Local development needs none of these — with no DATABASE_URL the app runs on
# JSON files under data/ and works straight after npm install.

# Postgres. Set this and the app switches to the Postgres store automatically.
# Neon (free tier) is what this was built against: https://neon.tech
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Optional. Without it, next week's plan and the playlist come from the
# deterministic rule engine rather than Claude. Both paths work; being able to
# run either against identical evidence is the point.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Per-task overrides. Each falls back to ANTHROPIC_MODEL, which falls back to
# the default in lib/model.ts. Reading one sentence and reading eight pages of
# PDF are not the same job, and one variable cannot price both correctly.
# ANTHROPIC_MODEL_EXTRACT="claude-haiku-4-5-20251001"
# ANTHROPIC_MODEL_PLAN="claude-sonnet-5"
# ANTHROPIC_MODEL_ADAPT="claude-sonnet-5"
# ANTHROPIC_MODEL_PLAYLIST="claude-haiku-4-5-20251001"
