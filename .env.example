# Local development needs none of these — with no DATABASE_URL the app runs on
# JSON files under data/ and works straight after npm install.

# Postgres. Set this and the app switches to the Postgres store automatically.
# Neon (free tier) is what this was built against: https://neon.tech
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Optional. Without it, next week's plan and the playlist come from the
# deterministic rule engine rather than Claude. Both paths work; being able to
# run either against identical evidence is the point.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Per-task overrides. Each falls back to ANTHROPIC_MODEL, which falls back to
# the default in lib/model.ts. Reading one sentence and reading eight pages of
# PDF are not the same job, and one variable cannot price both correctly.
# ANTHROPIC_MODEL_EXTRACT="claude-haiku-4-5-20251001"
# ANTHROPIC_MODEL_PLAN="claude-sonnet-5"
# ANTHROPIC_MODEL_ADAPT="claude-sonnet-5"
# ANTHROPIC_MODEL_PLAYLIST="claude-haiku-4-5-20251001"
# Meal photos default to claude-opus-5-5 and ignore ANTHROPIC_MODEL; only this moves them.
# ANTHROPIC_MODEL_MEAL="claude-opus-5-5"

# Optional. Without these, the "Connect Spotify" button on /music links to a
# route that throws, so leave all three unset until you have them. Create an
# app at developer.spotify.com/dashboard, add the redirect URI below under its
# settings, then copy the Client ID and secret here.
#
# Spotify no longer accepts "localhost" as a redirect host — it has to be the
# loopback IP, 127.0.0.1. That means the whole app has to be browsed at
# 127.0.0.1:3000 during local dev, not localhost:3000: the session cookie set
# at sign-in is host-scoped, so signing in on one and connecting Spotify on
# the other sends no cookie on the callback and getScope() sees a signed-out
# request.
# SPOTIFY_CLIENT_ID="..."
# SPOTIFY_CLIENT_SECRET="..."
# SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/spotify/callback"
