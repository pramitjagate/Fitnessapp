{
  "name": "second-week",
  "version": "0.1.0",
  "private": true,
  "description": "An adaptive strength coach that changes your plan on patterns, not single sessions.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "load-plan": "tsx --env-file=.env.local scripts/load-plan.ts",
    "log-week": "tsx --env-file=.env.local scripts/log-week.ts",
    "seed-demo": "tsx --env-file=.env.local scripts/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.1",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
